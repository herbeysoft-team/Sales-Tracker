# Copy this file to functions/.env (not committed) and fill in real values.

# The WhatsApp number(s) that should receive ledger alerts, in international
# format without "+", comma-separated for more than one, e.g:
# CALLMEBOT_PHONE=2348012345678,2348098765432
CALLMEBOT_PHONE=

# The API key CallMeBot's WhatsApp bot sends you after you message it once.
# See functions/README.md for the one-time setup steps.
CALLMEBOT_APIKEY=
